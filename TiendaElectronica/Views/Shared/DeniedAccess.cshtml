@{
    Layout = "_Layout";
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg mt-5 border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="mb-0">
                    <i class="bi bi-x-octagon-fill me-2"></i> 
                    Acceso Denegado 
                </h3>
            </div>
            <div class="card-body text-center">
                <p class="lead">
                    Lamentablemente, no tienes el nivel de acceso requerido para ver esta página o realizar esta acción.
                </p>
                <p class="text-muted">
                    Su rol de **Cliente** no tiene permisos para acceder a esta funcionalidad.  Esta sección está reservada para usuarios con el rol de **Administrador**.
                </p>
                
                <hr />
                
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                    <i class="bi bi-house-fill me-1"></i> Ir a la Página Principal
                </a>
                
                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger mt-3 ms-2">
                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}