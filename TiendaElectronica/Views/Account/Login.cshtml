@model TiendaElectronica.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    // Mantenemos el Layout, ya que la vista de Presupuestos no lo usaba, pero esta sí.
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<!-- Contenedor centrado y tarjeta estilizada -->
<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-5">
        <!-- Tarjeta con sombra pronunciada y bordes redondeados -->
        <div class="card shadow-lg border-0 rounded-3">
            
            <!-- Encabezado de la Tarjeta con estilo Primario -->
            <div class="card-header bg-primary text-white text-center py-3">
                <h1 class="h3 mb-0 fw-normal">
                    <i class="bi bi-person-circle me-2"></i> Iniciar Sesión
                </h1>
            </div>
            
            <!-- Cuerpo de la Tarjeta que contiene el formulario -->
            <div class="card-body p-4">
                
                <section>
                    <!-- Título H1 original, ahora dentro del card-header -->
                    
                    <form asp-controller="Account" asp-action="Login" method="post" role="form">
                        
                        <!-- Resumen de Validación General (si existe) -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <!-- Formulario de Usuario -->
                        <div class="form-group mb-3">
                            <label asp-for="Username" class="form-label fw-bold"></label>
                            <input asp-for="Username" class="form-control" placeholder="Ej: user@email.com" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Formulario de Contraseña -->
                        <div class="form-group mb-4">
                            <label asp-for="Password" class="form-label fw-bold"></label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Mínimo 6 caracteres" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Botón de Submit (d-grid para ancho completo) -->
                        <div class="form-group mb-3 d-grid">
                            <button type="submit" class="btn btn-lg btn-primary">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
                            </button>
                        </div>

                    </form>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @{
        // Asegura que se incluyan los scripts de validación
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}